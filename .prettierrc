{
    "semi": false,
    "singleQuote": true,
    "printWidth": 100,
    "trailingComma": "all",
    "plugins": [
        "prettier-plugin-organize-imports",
        "prettier-plugin-svelte",
        "prettier-plugin-tailwindcss"
    ],
    "tailwindFunctions": ["cn", "cva", "clsx"],
    "overrides": [
        { "files": "*.svelte", "options": { "parser": "svelte" } },
        { "files": "*.md", "options": { "proseWrap": "preserve" } }
    ]
}
