{
  "name": "@alfakit/svelte",
  "version": "0.1.1",
  "description": "Svelte 5 + shadcn-svelte renderer for Alfakit, the Laravel admin panel builder by Alfa Six.",
  "license": "MIT",
  "author": "Alfa Six (https://alfasixbh.com)",
  "homepage": "https://alfakit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfasixbh/alfakit",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/alfasixbh/alfakit/issues",
  "keywords": [
    "laravel",
    "inertia",
    "svelte",
    "shadcn-svelte",
    "admin",
    "panel",
    "alfakit"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "svelte": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./starter-kit": {
      "types": "./dist/starter-kit/index.d.ts",
      "svelte": "./dist/starter-kit/index.js",
      "default": "./dist/starter-kit/index.js"
    },
    "./kanban": {
      "types": "./dist/components/kanban/index.d.ts",
      "svelte": "./dist/components/kanban/index.js",
      "default": "./dist/components/kanban/index.js"
    },
    "./cms": {
      "types": "./dist/components/cms/index.d.ts",
      "svelte": "./dist/components/cms/index.js",
      "default": "./dist/components/cms/index.js"
    },
    "./translation-manager": {
      "types": "./dist/components/translation-manager/index.d.ts",
      "svelte": "./dist/components/translation-manager/index.js",
      "default": "./dist/components/translation-manager/index.js"
    },
    "./ai": {
      "types": "./dist/components/ai/index.d.ts",
      "svelte": "./dist/components/ai/index.js",
      "default": "./dist/components/ai/index.js"
    },
    "./tree": {
      "types": "./dist/components/tree/index.d.ts",
      "svelte": "./dist/components/tree/index.js",
      "default": "./dist/components/tree/index.js"
    },
    "./realtime": {
      "types": "./dist/components/realtime/index.d.ts",
      "svelte": "./dist/components/realtime/index.js",
      "default": "./dist/components/realtime/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./standalone.css": "./dist/standalone.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist && cp src/styles.css dist/styles.css && cp ../core/themes.css dist/themes.css && cp ../core/standalone.css dist/standalone.css && node ../../scripts/eject-manifest.mjs .",
    "dev": "svelte-package -i src -o dist --watch",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@alfakit/core": "workspace:*",
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/list": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.53.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-table": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "bits-ui": "^2.19.5",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^1.0.0"
  },
  "peerDependencies": {
    "@inertiajs/svelte": "^3.0.0",
    "svelte": "^5.29.0"
  },
  "devDependencies": {
    "@inertiajs/svelte": "^3.8.0",
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.1.4",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
