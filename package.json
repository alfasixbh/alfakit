{
  "name": "alfakit-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Alfakit — the frontend-agnostic admin panel builder for Laravel, by Alfa Six.",
  "license": "MIT",
  "author": "Alfa Six (https://alfasixbh.com)",
  "homepage": "https://alfakit.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/alfasixbh/alfakit"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "dev": "pnpm -r --parallel --filter './packages/*' run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @alfakit/e2e e2e",
    "showcase:record": "pnpm --filter @alfakit/e2e showcase:record --",
    "showcase:screenshots": "pnpm --filter @alfakit/e2e showcase:screenshots --",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "lint": "eslint . && prettier --check .",
    "bench": "node scripts/bench/run.mjs",
    "bench:docs": "node scripts/bench/run.mjs --docs-only",
    "perf:budget": "node scripts/perf-budget.mjs",
    "perf:budget:update": "node scripts/perf-budget.mjs --update",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "bundle:budget:update": "node scripts/bundle-budget.mjs --update",
    "test:scripts": "node --test scripts/*.test.mjs",
    "format": "prettier --write . && eslint . --fix",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "axe-core": "4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-svelte": "^3.23.1",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.0.0"
  }
}
