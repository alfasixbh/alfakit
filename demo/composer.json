{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "alfasix/alfakit-demo",
    "type": "project",
    "description": "Maison Alfa: the AlfaKit demo application, one Laravel app rendered by React, Vue and Svelte.",
    "license": "MIT",
    "homepage": "https://demo.alfakit.dev",
    "authors": [
        {
            "name": "Alfa Six",
            "homepage": "https://alfasixbh.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "alfasix/alfakit": "@dev",
        "alfasix/alfakit-activity-log": "@dev",
        "alfasix/alfakit-ai": "@dev",
        "alfasix/alfakit-analytics": "@dev",
        "alfasix/alfakit-api": "@dev",
        "alfasix/alfakit-backup": "@dev",
        "alfasix/alfakit-billing": "@dev",
        "alfasix/alfakit-calendar": "@dev",
        "alfasix/alfakit-cms": "@dev",
        "alfasix/alfakit-comments": "@dev",
        "alfasix/alfakit-feature-flags": "@dev",
        "alfasix/alfakit-file-manager": "@dev",
        "alfasix/alfakit-forms": "@dev",
        "alfasix/alfakit-health": "@dev",
        "alfasix/alfakit-helpdesk": "@dev",
        "alfasix/alfakit-invoices": "@dev",
        "alfasix/alfakit-kanban": "@dev",
        "alfasix/alfakit-mail-templates": "@dev",
        "alfasix/alfakit-media-library": "@dev",
        "alfasix/alfakit-ops": "@dev",
        "alfasix/alfakit-settings": "@dev",
        "alfasix/alfakit-shield": "@dev",
        "alfasix/alfakit-tags": "@dev",
        "alfasix/alfakit-teams": "@dev",
        "alfasix/alfakit-translation-manager": "@dev",
        "alfasix/alfakit-translations": "@dev",
        "alfasix/alfakit-tree": "@dev",
        "alfasix/alfakit-webhooks": "@dev",
        "alfasix/alfakit-workflows": "@dev",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/ai": "^1.2",
        "laravel/framework": "^13.17",
        "laravel/pennant": "^1.26",
        "laravel/tinker": "^3.0",
        "spatie/laravel-activitylog": "^5.1",
        "spatie/laravel-backup": "^10.3",
        "spatie/laravel-health": "^1.40",
        "spatie/laravel-medialibrary": "^11.23",
        "spatie/laravel-permission": "^8.3",
        "spatie/laravel-settings": "^3.9",
        "spatie/laravel-tags": "^4.12"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan demo:reset"
        ],
        "lint": [
            "pint --parallel"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "types:check": [
            "phpstan analyse"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "repositories": [
        {
            "type": "path",
            "url": "../packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../packages/plugins/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "prefer-stable": true
}
