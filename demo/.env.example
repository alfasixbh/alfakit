APP_NAME="Maison Alfa"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://alfakit-demo.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@maison-alfa.test"
MAIL_FROM_NAME="${APP_NAME}"

ALFAKIT_FILESYSTEM_DISK=demo
ALFAKIT_UPLOAD_MAX_KB=4096
DEMO_SEED_SCALE=1
# Start the SSR server with `node bootstrap/ssr/ssr.js` (see DEPLOY.md), then enable it here.
INERTIA_SSR_ENABLED=false
INERTIA_SSR_URL=http://127.0.0.1:13720
VITE_APP_NAME="${APP_NAME}"

# The public AlfaKit website (docs and AI pages linked from the demo).
ALFAKIT_SITE_URL=https://alfakit.dev
